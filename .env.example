# Copy to .env and fill in. Updates never overwrite .env.

# Your Discord server ID (Developer Mode on -> right-click server -> Copy Server ID)
DISCORD_GUILD_ID=

# How Siloquy reaches Silo. Pick ONE:
#   Silo's port published on this same machine (Silo's default is 8090):
SILO_URL=http://host.docker.internal:8090
#   Silo on another machine on your LAN:
# SILO_URL=http://192.168.1.50:8090
#   Silo behind HTTPS (any non-local address must use https):
# SILO_URL=https://silo.example.com
#   Same Docker network as Silo (also set COMPOSE_FILE + SILO_NETWORK below):
# SILO_URL=http://silo:8080

# Optional presets (uncomment ONE):
#   Join Silo's Docker network:
# COMPOSE_FILE=docker-compose.yml:compose.network.yml
# SILO_NETWORK=
#   Saltbox (joins the saltbox network, adds the backup label):
# COMPOSE_FILE=docker-compose.yml:compose.saltbox.yml

TZ=Etc/UTC
# Optional:
# STATS=status,streams,transcodes,direct,bandwidth,users,cpu,memory,storage
# POLL_SECONDS=30
# RESOURCE_SCOPE=silo   # silo = Silo + its transcoders (default), host = whole machine
